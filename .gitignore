# .gitignore
/target/
/tools/protogen/target/
**/*.rs.bk
.DS_Store
*.swp
.env
.env.*
!.env.example
experiments/lab/logs/
*.log
/refs/

# Demo CRS checkout (install-crs.sh) and runtime state (up.sh)
demo/.crs
demo/.crs/
demo/.run/
demo/.run-other/

# CRS checkouts for other tags (scripts/crs-version-probe.sh)
demo/.crs-*/

# ASH scan output. Config stays at .ash/.ash.yaml.
.ash/ash_output/

# Docsify / GitHub Pages: never ignore .nojekyll (Pages needs it under /docs).
!**/.nojekyll
!.nojekyll
