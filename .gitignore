# .gitignore
/target/
/tools/protogen/target/
**/*.rs.bk
.DS_Store
*.swp
.env
.env.*
!.env.example
*.log
__pycache__/
*.py[cod]

# Demo CRS checkout (install-crs.sh) and runtime state (up.sh)
/demo/.crs/
/demo/.run/
# CRS checkouts for other tags (ci-live-e2e.sh with CRS_TAG)
/demo/.crs-*/
# Manual `go build` in demo/grpc-echo (the suites build into demo/.run/)
/demo/grpc-echo/grpc-echo

# ASH scan output. Config stays at .ash/.ash.yaml.
/.ash/ash_output*/
